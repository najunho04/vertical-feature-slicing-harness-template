{
  "permissions": {
    "deny": [
      "Bash(rm *contract*)",
      "Bash(git rm *contract*)",
      "Bash(mv *contract*)",
      "Bash(cd ..*)",
      "Bash(*../*)",
      "Bash(git -C ..*)",
      "Bash(*HARNESS_ADMIN*)"
    ],
    "ask": [
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Edit(backend/src/common/**)",
      "Write(backend/src/common/**)",
      "Edit(backend/src/shared/**)",
      "Write(backend/src/shared/**)",
      "Edit(front/src/common/**)",
      "Write(front/src/common/**)",
      "Edit(front/src/shared/**)",
      "Write(front/src/shared/**)",
      "Edit(CLAUDE.md)",
      "Edit(Makefile)",
      "Edit(.claudeignore)",
      "Edit(.githooks/**)",
      "Edit(.claude/**)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(HARNESS_APPROVED=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-frozen-contract.py\""
          }
        ]
      }
    ]
  }
}
