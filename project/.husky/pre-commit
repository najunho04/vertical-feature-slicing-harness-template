#!/usr/bin/env sh
# 동결 경로 및 공용 레이어의 임의 변경을 커밋 단계에서 차단한다.
# 승인된 변경은 HARNESS_APPROVED=1 로 커밋하고 project-all-docs/approvals.md 에 기록한다.

FROZEN_PATHS="
backend/test/contract/
front/test/contract/
e2e/
backend/src/common/
backend/src/shared/
front/src/common/
front/src/shared/
CLAUDE.md
package.json
.eslintrc
.claudeignore
.husky/
"

if [ "$HARNESS_APPROVED" = "1" ]; then
  echo "[harness] HARNESS_APPROVED=1 — 동결 경로 검사 생략. approvals.md 에 기록할 것."
  exit 0
fi

STAGED=$(git diff --cached --name-only)
VIOLATIONS=""
for path in $FROZEN_PATHS; do
  MATCH=$(echo "$STAGED" | grep "^$path" || true)
  [ -n "$MATCH" ] && VIOLATIONS="$VIOLATIONS
$MATCH"
done

if [ -n "$VIOLATIONS" ]; then
  echo "[harness] 동결 경로 변경이 감지되어 커밋을 차단합니다:"
  echo "$VIOLATIONS"
  echo ""
  echo "구현 코드를 고쳐 테스트를 통과시키거나, 명세 불일치라면 멈추고 사용자에게 보고하세요."
  exit 1
fi
