#!/usr/bin/env sh
# 커밋 시점 경계 검사. 두 등급으로 나뉜다.
#   하드 (exit 2): 계약 테스트. 어떤 경우에도 커밋 불가. 변경이 필요하면 사람이 훅 밖에서 처리한다.
#   소프트 (exit 1): 공용 레이어·E2E·설정 파일. 기본 차단. 사람이 승인한 경우 HARNESS_APPROVED=1 로 커밋하고
#                    project-all-docs/approvals.md 에 기록한다. 이 변수는 사용자만 쓴다.

HARD_PATHS="
backend/test/contract/
front/test/contract/
"

SOFT_PATHS="
e2e/
backend/src/common/
backend/src/shared/
front/src/common/
front/src/shared/
CLAUDE.md
package.json
.eslintrc
.claudeignore
.husky/
.claude/
"

STAGED=$(git diff --cached --name-only)

match_paths() {
  for path in $1; do
    echo "$STAGED" | grep "^$path" || true
  done
}

HARD_HITS=$(match_paths "$HARD_PATHS")
if [ -n "$HARD_HITS" ]; then
  echo "[harness] 동결 경로 변경이 감지되어 커밋을 차단합니다 (하드):"
  echo "$HARD_HITS"
  echo ""
  echo "구현 코드를 고쳐 테스트를 통과시키거나, 명세 불일치라면 멈추고 사용자에게 보고하세요."
  exit 2
fi

SOFT_HITS=$(match_paths "$SOFT_PATHS")
if [ -n "$SOFT_HITS" ]; then
  if [ "$HARNESS_APPROVED" = "1" ]; then
    echo "[harness] HARNESS_APPROVED=1 — 보호 경로 변경 승인됨. approvals.md 에 기록할 것:"
    echo "$SOFT_HITS"
    exit 0
  fi
  echo "[harness] 보호 경로 변경이 감지되어 커밋을 차단합니다 (소프트):"
  echo "$SOFT_HITS"
  echo ""
  echo "코드를 작성하지 말고 멈춰서 필요한 변경 사항을 사용자에게 설명하세요."
  echo "사용자가 승인하면 HARNESS_APPROVED=1 git commit 으로 커밋합니다."
  exit 1
fi

exit 0
